# =============================================================================
# GEM VERIFIER V2 - BACKEND ENVIRONMENT CONFIGURATION (.env)
# =============================================================================

# Server Configuration
APP_NAME=GeM Bid Compliance API
NODE_ENV=development
PORT=8000
API_PREFIX=/api

# CORS Allowed Origins (Comma-separated list for multi-origin support)
# LOCAL DEVELOPMENT: http://localhost:5173
# PRODUCTION (Render): https://gem-sarathi.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# JWT Authentication Secrets
JWT_SECRET_KEY=replace-with-a-secure-production-jwt-secret-key
JWT_EXPIRES_IN=8h

# Database Configuration
# LOCAL DEMO: DB_MODE=file (uses embedded data/db.json)
# PRODUCTION (Render): DB_MODE=supabase
DB_MODE=supabase
SUPABASE_URL=https://your-project.supabase.co
# Server-Side Only: Use the Supabase Service Role Key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=bid-uploads

# AI Processing (Google Gemini API - Server Side Only)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# FRONTEND VERCEL ENVIRONMENT VARIABLE REFERENCE (Set in Vercel Dashboard)
# =============================================================================
# VITE_API_BASE_URL=https://your-render-app-domain.onrender.com/api
# =============================================================================
