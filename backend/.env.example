APP_NAME=GeM Bid Compliance API
NODE_ENV=development
PORT=8000
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
JWT_SECRET_KEY=replace-with-a-long-development-secret
JWT_EXPIRES_IN=8h
# Embedded file database (zero setup). Change path if needed.
DB_FILE=./data/db.json

# ---- Production upgrade (Supabase). Leave empty for offline file mode. ----
# DB_MODE=file            # default: embedded JSON store
# DB_MODE=supabase        # production: Supabase Postgres (run backend/supabase/schema.sql first)
DB_MODE=file
SUPABASE_URL=
# Use the server-only service-role key; never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=bid-uploads

# Optional: set a Google Gemini key to add LLM second opinions on top of the
# deterministic compliance engine. Leave empty for fully-offline demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
